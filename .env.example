# PUBLIC MARKETING OPTIONAL SERVICES (not a full application environment template)
# Analytics stays disabled unless both are configured at build time.
# Use a PostHog project ingestion key here, NEVER a personal/admin API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Online enquiry delivery stays disabled until all four are set.
# Restrict the Turnstile widget to vaxeron.com and www.vaxeron.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Must be a verified Resend sender. Recipient is fixed server-side to hello@vaxeron.com.
CONTACT_FROM_EMAIL=
